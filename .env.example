# Copy this file to .env. The real .env is ignored by git and survives git pull.

# Primary model used by the current node bindings.
SQLMATE_PRIMARY_BASE_URL=https://your-openai-compatible-gateway.example.com/
SQLMATE_PRIMARY_API_KEY=replace-me
SQLMATE_PRIMARY_MODEL=GLM-5.2
SQLMATE_PRIMARY_TIMEOUT=1800
# Set false only for an intranet gateway with a self-signed certificate.
SQLMATE_PRIMARY_VERIFY_SSL=false

# Optional GLM provider for nodes that are explicitly rebound to ark_glm.
SQLMATE_GLM_BASE_URL=https://your-openai-compatible-gateway.example.com/
SQLMATE_GLM_API_KEY=replace-me
SQLMATE_GLM_MODEL=GLM-5.2
SQLMATE_GLM_TIMEOUT=1800
SQLMATE_GLM_VERIFY_SSL=false

# Optional external knowledge directory.
SQLMATE_DOC_KNOWLEDGE_DIR=knowledge
